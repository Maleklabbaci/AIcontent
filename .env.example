# Public Supabase client configuration used by the browser build.
# Never put Gemini or Canva credentials in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Note — authentification obligatoire :
# dès que VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY sont renseignées, /login et /signup
# deviennent la porte d'entrée de l'application (seule la landing reste publique).
# Désactivez la confirmation d'email Supabase pour que signUp ouvre la session directement.

# Cloudflare Pages (côté serveur, jamais exposé au navigateur) :
# GEMINI_API_KEY=...
# CANVA_ACCESS_TOKEN=...
